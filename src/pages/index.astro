---
import Layout from '../layouts/Layout.astro';
import donkeyOutline from '../../materials/svg/donkey2-outline.svg?raw';

// Path data comes straight from the exported outline, so re-exporting the SVG updates the page.
const d = donkeyOutline.match(/ d="([^"]+)"/)?.[1] ?? '';

// Tiling, in the outline's own units (its viewBox is 375 x 285).
const step = { x: 420, y: 330 }; // gaps between nose and next tail, and between rows
const rowOffset = 210; // every other row shifts by half a donkey
const scale = 0.3; // ~110px wide on screen
const strokePx = 1.2;

// Full class names so Tailwind can find them: outline for the herd, fill for the highlighted few.
const colors = [
	{ stroke: 'stroke-green-500', fill: 'fill-green-500' },
	{ stroke: 'stroke-blue-500', fill: 'fill-blue-500' },
	{ stroke: 'stroke-red-500', fill: 'fill-red-500' },
	{ stroke: 'stroke-orange-500', fill: 'fill-orange-500' },
];
const rows = [
	[0, 1, 2, 3],
	[2, 3, 0, 1], // shifted row: no two neighbours share a colour
];

// One pattern tile is 4 donkeys x 2 rows. Extra copies one tile up/left fill in
// the parts of donkeys that cross the tile's edges.
const tile = { w: rows[0].length * step.x, h: rows.length * step.y };
const donkeys = rows.flatMap((order, r) =>
	order.flatMap((colorIndex, c) =>
		[-tile.w, 0].flatMap((dx) =>
			[-tile.h, 0].map((dy) => ({
				x: dx + c * step.x + (r % 2 ? rowOffset : 0),
				y: dy + r * step.y,
				color: colors[colorIndex].stroke,
			})),
		),
	),
);

// The herd is anchored to the centre of the screen: (0, 0) below is the screen's midpoint,
// shifted left by half a donkey so a donkey in row 0 sits exactly on the vertical midline.
const origin = { x: -375 / 2, y: 0 };

// Three solid donkeys of different colours around the midline, picked by grid position:
// the centred one in row 0, and the two flanking the midline in the (shifted) row 1.
const colorAt = (r: number, c: number) => colors[rows[r % 2][((c % 4) + 4) % 4]];
const highlighted = [
	{ r: 0, c: 0 },
	{ r: 1, c: -1 },
	{ r: 1, c: 0 },
].map(({ r, c }) => ({
	x: c * step.x + (r % 2 ? rowOffset : 0),
	y: r * step.y,
	color: colorAt(r, c).fill,
}));

// The Chinese line sits just under the lowest solid donkey (285 = donkey height in outline units).
const captionTop = Math.max(...highlighted.map(({ y }) => y + 285)) * scale + 28; // px below screen middle
---

<Layout>
	<svg class="fixed inset-0 h-full w-full opacity-35" aria-hidden="true">
		<defs>
			<path
				id="donkey"
				d={d}
				stroke-width={strokePx / scale}
				stroke-linejoin="round"
				stroke-linecap="round"
			/>
			<pattern id="herd" patternUnits="userSpaceOnUse" width={tile.w * scale} height={tile.h * scale}>
				<g transform={`scale(${scale})`} fill="none">
					{donkeys.map(({ x, y, color }) => <use href="#donkey" x={x} y={y} class={color} />)}
				</g>
			</pattern>
		</defs>
		<svg x="50%" y="50%" overflow="visible">
			<g transform={`translate(${origin.x * scale} ${origin.y * scale})`}>
				<!-- Oversized so it covers the screen from any anchor point; the pattern repeats from this group's origin. -->
				<rect x="-50000" y="-50000" width="100000" height="100000" fill="url(#herd)"></rect>
				<g transform={`scale(${scale})`}>
					{highlighted.map(({ x, y, color }) => <use href="#donkey" x={x} y={y} class={color} />)}
				</g>
			</g>
		</svg>
	</svg>

	<p
		lang="zh-Hant"
		class="fixed left-1/2 -translate-x-1/2 text-center text-xl leading-normal font-medium whitespace-nowrap text-ink md:text-2xl"
		style={`top: calc(50% + ${captionTop}px)`}
	>
		因思杜陵夢<br />鳧雁滿回塘
	</p>

	<!-- Orphans: the last few words of each paragraph are joined with non-breaking spaces (&nbsp;),
	     so they always wrap together in every browser. -->
	<!-- Content sits on a 12-column grid inside a centred lg (1024px) container;
	     the text takes the middle 10 columns on tablets and the middle 8 on desktop. -->
	<main class="relative mx-auto grid max-w-screen-lg grid-cols-12 gap-x-6 px-6 pt-8 sm:px-10 md:pt-12 lg:pt-16">
		<div class="col-span-12 space-y-8 md:col-span-10 md:col-start-2 lg:col-span-8 lg:col-start-3 font-serif text-[1.625rem] leading-[1.22] text-ink md:space-y-10 md:text-[2rem] lg:text-[2.25rem]">
			<blockquote>
				<p>
					All creatures are four-legged, looking down at the earth, drawn towards the earth. Man alone
					stands up on the earth, and raises his hands and head to&nbsp;the&nbsp;sky.
				</p>
			</blockquote>
			<blockquote>
				<p>The old woman in the church prays: “Each of us shall reap according to&nbsp;his&nbsp;sins.”</p>
			</blockquote>
		</div>
	</main>
</Layout>

<style>
	main {
		font-kerning: normal;
		font-variant-ligatures: common-ligatures;
		text-rendering: optimizeLegibility;
	}
</style>
